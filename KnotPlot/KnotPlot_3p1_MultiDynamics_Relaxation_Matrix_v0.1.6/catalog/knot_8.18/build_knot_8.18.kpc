% build_knot_8.18.kpc
reset all
load 8.18
nbeads 300
mode cb

centre
fitto mindist 1.05

collision fast
close = 1.0
max-dr = 0.01

mechforce = on
elecforce = on
bendforce = on
bencon = 1.0

stusplit = 0
dstep = 1

bradius = 0.1
cradius = 0.05

energy model MD
energy

echo CHECKPOINT i00000
safe
dowker
lnknum
length
distance
angle
acn
save __MATRIX_ROOT__/catalog/knot_8.18/knot_8.18_i00000.k float
coords __MATRIX_ROOT__/catalog/knot_8.18/knot_8.18_i00000.txt

ago 1000
