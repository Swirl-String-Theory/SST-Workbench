{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SST Workbench FAMILY metadata v2",
  "type": "object",
  "required": [
    "catalog_id",
    "domain",
    "letter",
    "slug",
    "name",
    "kind",
    "status"
  ],
  "properties": {
    "catalog_id": {
      "type": "string",
      "pattern": "^[A-Z][0-9]{3}$"
    },
    "domain": {
      "type": "string"
    },
    "letter": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "latest": {
      "type": [
        "string",
        "null"
      ]
    },
    "unversioned": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "versions": {
      "type": "array"
    },
    "variants": {
      "type": "array"
    },
    "layout": {
      "type": "array"
    },
    "legacy_paths": {
      "type": "array"
    },
    "intermediate_paths": {
      "type": "array"
    },
    "repro_gate": {
      "type": "object",
      "properties": {
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "tier": {},
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "equivalence": {},
        "tolerance": {},
        "note": {}
      },
      "additionalProperties": true
    },
    "execution": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "notes": {
          "type": [
            "string",
            "array",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "scientific": {
      "type": "object",
      "properties": {
        "overall": {
          "type": "string"
        },
        "claims": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object"
    }
  },
  "not": {
    "required": [
      "gate"
    ]
  },
  "additionalProperties": true
}