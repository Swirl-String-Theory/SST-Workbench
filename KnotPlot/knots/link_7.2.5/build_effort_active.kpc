% build_link_7.2.5.kpc
reset all
load 7.2.5
refine nbeads 600
mode cb

centre
fitto mindist 1.05

collision fast
close = 1.0
max-dr = 0.01

mechforce = on
elecforce = on
bendforce = on
bencon = 1.0

stusplit = 0
dstep = 1

bradius = 0.1
cradius = 0.05

energy model MD
energy

echo CHECKPOINT analytic_D1
safe
dowker
lnknum
length
distance
angle
acn
save knots/link_7.2.5/link_7.2.5_analytic_D1.txt

ago 1000
echo CHECKPOINT trial_001k
safe
dowker
lnknum
length
distance
angle
acn
save knots/link_7.2.5/link_7.2.5_trial_001k.txt

