% Trefoil Seed Campaign v0.1.3 -- export canonical KnotPlot 3.1 base
% Syntax intentionally mirrors the user's working build_knot_0.1.kpc.

reset all
load 3.1
refine nbeads 300
mode cb

centre
fitto mindist 1.05

collision fast
close = 1.0
max-dr = 0.01

mechforce = on
elecforce = on
bendforce = on
bencon = 1.0

stusplit = 0
dstep = 1

bradius = 0.1
cradius = 0.05

energy model MD
energy

echo CHECKPOINT base_i00000
safe
dowker
lnknum
length
distance
angle
acn

save KnotPlot_3p1_Trefoil_Seed_Campaign_v0.1.3/base/base_3p1_300.k float
coords KnotPlot_3p1_Trefoil_Seed_Campaign_v0.1.3/base/base_3p1_300.txt
stop
