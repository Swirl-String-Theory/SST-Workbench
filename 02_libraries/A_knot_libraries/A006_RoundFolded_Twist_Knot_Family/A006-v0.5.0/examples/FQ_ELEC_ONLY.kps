% A006_FORCE_QUALIFICATION_v0.5.0b; independent force arm ELEC_ONLY; GUI SAFE (NO stop)
reset all
load Output/v050/geometry/LINK_5_5_6_BALANCED_N1024_ORIG_CPFIXED61.xyz
show backdrop
mode cb
bradius = 0.20
cradius = 0.10
collision fast
collision
energy model MD
close = 0.20
max-dr = 0.02
dstep = 1
stusplit = 0
mechforce = off
elecforce = on
amechforce = off
aelecforce = off
thermalforce = off
bendforce = off
bencon = 1
extforce = off
velforce = off
gravity = off
drag = off
tanforce = off
tanmag = 9
spring-length = 1.4
hooke = 1
power = 5
charge = 15
tinc = 15
go beadlimit 4000
information
length
safe
data open Output/qualification_v050b/runs/ELEC_ONLY/native.csv
data format "/I,/N,/l,/g"
data header "iteration,nbeads,length,rog"
echo FORCEQUAL_ELEC_ONLY_CHECKPOINT_0000000
length
rog
safe
collision
coords Output/qualification_v050b/runs/ELEC_ONLY/i0000000.xyz
data
ago 1
echo FORCEQUAL_ELEC_ONLY_CHECKPOINT_0000001
length
rog
safe
collision
coords Output/qualification_v050b/runs/ELEC_ONLY/i0000001.xyz
data
ago 7
echo FORCEQUAL_ELEC_ONLY_CHECKPOINT_0000008
length
rog
safe
collision
coords Output/qualification_v050b/runs/ELEC_ONLY/i0000008.xyz
data
ago 24
echo FORCEQUAL_ELEC_ONLY_CHECKPOINT_0000032
length
rog
safe
collision
coords Output/qualification_v050b/runs/ELEC_ONLY/i0000032.xyz
data
ago 96
echo FORCEQUAL_ELEC_ONLY_CHECKPOINT_0000128
length
rog
safe
collision
coords Output/qualification_v050b/runs/ELEC_ONLY/i0000128.xyz
data
data close
collision
echo FORCEQUAL_ELEC_ONLY_GUI_FINISHED
% Do not add stop/exit/quit to interactive scripts
