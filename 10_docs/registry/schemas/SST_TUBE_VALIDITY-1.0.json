{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SST_TUBE_VALIDITY-1.0",
  "title": "SST_TUBE_VALIDITY-1.0",
  "description": "Bishop tube reach gate. Failure must not shrink r_max.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "record_type",
    "status",
    "rmax",
    "rmax_was_reduced",
    "c_kappa",
    "c_d"
  ],
  "properties": {
    "schema": { "const": "SST_TUBE_VALIDITY-1.0" },
    "schema_version": { "const": "1.0" },
    "record_type": { "const": "tube_validity" },
    "status": {
      "enum": ["TUBE_VALID", "INDETERMINATE_TUBE_CHART_INVALID"]
    },
    "rmax": { "type": "number" },
    "rmax_was_reduced": { "const": false },
    "c_kappa": { "type": "number" },
    "c_d": { "type": "number" }
  }
}
