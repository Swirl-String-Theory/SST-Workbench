{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SST_MODE_RECONSTRUCTION-1.0",
  "title": "SST_MODE_RECONSTRUCTION-1.0",
  "description": "Seal rebuilt A029 (q_m, p_m) against a frozen case before any producer trajectory.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "record_type",
    "status",
    "carrier_id",
    "q_hash",
    "p_hash",
    "biorthogonality_residual"
  ],
  "properties": {
    "schema": { "const": "SST_MODE_RECONSTRUCTION-1.0" },
    "schema_version": { "const": "1.0" },
    "record_type": { "const": "mode_reconstruction" },
    "status": {
      "enum": ["RECONSTRUCTED_SAME_BRANCH", "INDETERMINATE_MODE_RECONSTRUCTION"]
    },
    "carrier_id": { "type": "string" },
    "q_hash": { "type": "string", "minLength": 64, "maxLength": 64 },
    "p_hash": { "type": "string", "minLength": 64, "maxLength": 64 },
    "biorthogonality_residual": { "type": "number" }
  }
}
