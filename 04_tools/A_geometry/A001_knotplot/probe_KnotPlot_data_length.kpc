% Diagnostic only: does not save geometry or alter source files.
% Run in the KnotPlot working directory (will write three separate PROBE_*.csv files).
reset all
load 3.1
length
data open PROBE_LENGTH_immediate.csv
data format "/N,/l"
data header "N_total,L_total"
data
data close
distance
data open PROBE_LENGTH_after_distance.csv
data format "/N,/l"
data header "N_total,L_total"
data
data close
length
data open PROBE_LENGTH_spaced_format.csv
data format "/N, /l"
data header "N_total,L_total"
data
data close
