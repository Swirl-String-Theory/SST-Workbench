% ======================================================================
% 50_close_sweep_MEB.kpc
% KnotPlot 3.1 controlled relaxation matrix
% Purpose: Collision-distance sweep with full M+E+B dynamics.
%
% IMPORTANT:
% - Every candidate starts from reset all + load 3.1.
% - refine nbeads 300 is used because the target KnotPlot runtime marks nbeads obsolete.
% - ago is atomic: saves happen only after the requested iterations.
% - All non-swept dynamical parameters are explicitly fixed.
% - Saved .k files use float format; coords .txt are plain XYZ-like data.
% ======================================================================

% ----------------------------------------------------------------------
% Candidate: D50_MEB_close0p5
% mech=true elec=true bend=true
% charge=15 bencon=1 power=6
% hooke=1 timeincr=15
% close=0.5 max-dr=0.01
% ----------------------------------------------------------------------
reset all
load 3.1
refine nbeads 300
mode cb

centre
fitto mindist 1.05

collision fast
close = 0.5
max-dr = 0.01

mechforce = on
elecforce = on
bendforce = on

charge 15
hooke 1
power 6
timeincr 15
bencon = 1

stusplit = 0
dstep = 1

bradius = 0.1
cradius = 0.05

energy model MD

% Initial state
centre
energy
writhe
length
rog
save __MATRIX_ROOT__/out/D50_MEB_close0p5_i00000.k float
coords __MATRIX_ROOT__/out/D50_MEB_close0p5_i00000.txt

% 1,000 iterations
ago 1000
centre
energy
writhe
length
rog
save __MATRIX_ROOT__/out/D50_MEB_close0p5_i01000.k float
coords __MATRIX_ROOT__/out/D50_MEB_close0p5_i01000.txt

% 4,000 cumulative iterations
ago 3000
centre
energy
writhe
length
rog
save __MATRIX_ROOT__/out/D50_MEB_close0p5_i04000.k float
coords __MATRIX_ROOT__/out/D50_MEB_close0p5_i04000.txt

% 10,000 cumulative iterations
ago 6000
centre
energy
writhe
length
rog
save __MATRIX_ROOT__/out/D50_MEB_close0p5_i10000.k float
coords __MATRIX_ROOT__/out/D50_MEB_close0p5_i10000.txt

