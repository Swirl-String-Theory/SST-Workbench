{
  "schema": "SST-BLIND-POLICY-2",
  "enabled": true,
  "private_forbidden_terms_path": "private/blind_forbidden_terms.txt",
  "private_nonce_path": "private/REVEAL_NONCE.bin",
  "commitment_path": "preregistration/BLIND_TERMS_COMMITMENT.json",
  "scan_suffixes": [
    ".py",
    ".json",
    ".md",
    ".txt",
    ".toml",
    ".cmd",
    ".cpp",
    ".h",
    ".hpp",
    ".tex",
    ".csv"
  ],
  "private_reveal_path": "private/reveal.json",
  "reveal_commitment_path": "preregistration/REVEAL_COMMITMENT.json",
  "reveal_allowed_after_modes": [
    "FULL",
    "CERTIFY"
  ],
  "reveal_requires_gate": "G3",
  "reveal_requires_gate_status": [
    "PASS",
    "FAIL"
  ],
  "block_reveal_on_unresolved": true
}
