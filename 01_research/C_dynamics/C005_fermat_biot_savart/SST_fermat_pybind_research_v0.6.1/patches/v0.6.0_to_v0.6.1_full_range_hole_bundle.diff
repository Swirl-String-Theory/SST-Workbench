+    ez = _unit(params.axis_direction)
+    ref = np.array([1.0, 0.0, 0.0]) if abs(ez[0]) < 0.9 else np.array([0.0, 1.0, 0.0])
+    ex = ref - np.dot(ref, ez) * ez
