      "delay_seconds": 0.8,
      "retries": 3,
      "backoff_seconds": 2.0
    }
  },
  "friendly_knot_aliases": [
    {
      "alias": "10_1",
      "target_id": "10_1",
      "reason": "Fremlin/Rolfsen favorite; direct unsharded convenience duplicate."
    },
    {
      "alias": "10_2",
      "target_id": "10_2",
