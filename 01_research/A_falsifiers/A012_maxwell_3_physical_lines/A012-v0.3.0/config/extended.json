{
  "protocol_version": "0.3.0",
  "profile": "extended",
  "blindness": {
    "mode": "target-blind + provenance-redacted",
    "split_seed": "SST-MAXWELL-3-PHYSICAL-LINES-PKLSA-v0.3.0",
    "rule": "No historical coefficient or SST circulation target is available to blind gate code."
  },
  "physical_constants": {
    "rho_f_kg_m3": 7e-07,
    "v_swirl_m_s": 1093845.63,
    "r_c_m": 1.40897017e-15
  },
  "selection": {
    "topology_include": [],
    "max_topologies": 0,
    "max_carriers_per_topology": 1
  },
  "pklsa_admission": {
    "require_topology_qualification_gate": false,
    "require_literature_hard_gate": true,
    "exclude_mirrors": true,
    "exclude_raw_duplicates": true,
    "exclude_geometry_duplicates": true,
    "fail_closed_on_runtime_carrier_error": true,
    "note": "Full PKLSA-v0.3.x topology scan; one deterministic admissible carrier per topology. Aggregate failed topologies are not promoted to topology-class evidence."
  },
  "topology_track": {
    "source_resample_points": 384,
    "probe_points": 256,
    "fseries_n": 4096,
    "meridian_radius_reach_factor": 0.45
  },
  "stress_track": {
    "enabled": true,
    "max_cases": 24,
    "one_per_topology": true,
    "allowed_reach_status": [
      "RESOLVED"
    ],
    "resample_points": 300,
    "stations_per_component": 12,
    "radial_samples": 3,
    "angular_samples": 12,
    "sample_radius_reach_factor": 0.8,
    "vref_radius_reach_factor": 1.0
  },
  "gates": {
    "topology": {
      "runtime_carrier_errors_max": 0,
      "m6_unit_slope_abs_error_max": 0.05,
      "m6_null_abs_circulation_max": 0.02,
      "m6_fit_r2_min": 0.998,
      "exact_linking_integer_residual_max": 0.01,
      "m7_relative_error_max": 0.05,
      "require_multicomponent_case": true
    },
    "stress": {
      "min_cases": 3,
      "median_axisymmetry_residual_max": 0.3,
      "median_director_alignment_min": 0.85,
      "positive_anisotropy_fraction_min": 0.75
    }
  },
  "reduced_momentum_track": {
    "required": false,
    "gates": {
      "validation_nrmse_max": 0.05,
      "validation_cosine_median_min": 0.995,
      "group_slope_cv_max": 0.05,
      "factorization_relative_error_max": 0.05
    }
  },
  "storage_current_track": {
    "required": false,
    "gates": {
      "validation_nrmse_max": 0.2,
      "validation_r2_min": 0.9,
      "residual_reduction_min": 0.8
    }
  },
  "runtime": {
    "require_native": true,
    "require_pklsa_native": true
  },
  "decision_rule": {
    "FAIL": "Any mandatory blind gate fails.",
    "INCONCLUSIVE": "Required evidence is unavailable.",
    "PASS": "All mandatory carrier-level gates pass under the declared PKLSA admission contract."
  }
}
