+def kabsch_align(P, Q):
+    P = np.asarray(P, float)
+    Q = np.asarray(Q, float)
+    Pc = P - P.mean(0)
+    Qc = Q - Q.mean(0)
+    H = Pc.T @ Qc
+    U, S, Vt = np.linalg.svd(H)
+    R = Vt.T @ U.T
+    if np.linalg.det(R) < 0:
+        Vt[-1] *= -1
+        R = Vt.T @ U.T
+    return Pc @ R
+
