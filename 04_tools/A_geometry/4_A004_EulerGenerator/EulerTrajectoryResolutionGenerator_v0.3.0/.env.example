# Copy to .env in this folder (gitignored) to override defaults.
# Shell-set SST_PYTHON always wins over this file.

# Default lane is xpu when unset:
# SST_GPU_LANE=xpu
# SST_GPU_LANE=cuda

# Or point at an explicit interpreter:
# SST_PYTHON=C:\workspace\projects\SST-Workbench\.venv-a075-xpu\Scripts\python.exe

# Optional workbench root if auto-discovery fails:
# SST_WORKBENCH_ROOT=C:\workspace\projects\SST-Workbench
