{
  "dataset": "..\\..\\KnotPlot\\knots\\final",
  "max_pairs": 12,
  "target_name_patterns": [
    "(?:knot|trefoil)?[^0-9]*3[._-]1",
    "(?:knot)?[^0-9]*7[._-]4",
    "(?:knot)?[^0-9]*4[._-]1",
    "torus[^0-9]*2[._-]7",
    "torus[^0-9]*2[._-]4",
    "torus[^0-9]*3[._-]6",
    "link"
  ],
  "mirror_axis": 0,
  "resolutions": [
    72,
    96,
    128
  ],
  "min_points_per_component": 24,
  "core_fractions": [
    0.018,
    0.025,
    0.035
  ],
  "component_gap_factor": 6.0,
  "allow_equal_torus_split": true,
  "reject_ambiguous_links": true,
  "max_ds_cv_prepare": 0.35,
  "max_ds_cv": 0.25,
  "trajectory_time": 0.14,
  "trajectory_cfl": 0.16,
  "min_trajectory_steps": 28,
  "max_trajectory_steps": 180,
  "trajectory_samples": 24,
  "jvp_eps_fraction": 1.5e-05,
  "packet_width": 0.075,
  "transport_dead_zone": 0.018,
  "excitation_centers": [
    0.125,
    0.375,
    0.625,
    0.875
  ],
  "carrier_modes": [
    2,
    3,
    5
  ],
  "excite_all_components": true,
  "max_excited_components": 3,
  "compute_tube_helicity": true,
  "helicity_radial_nodes": 3,
  "helicity_angles": 8,
  "compute_frozen_spectrum": false,
  "helicity_odd_tolerance": 0.05,
  "gauss_odd_tolerance": 0.05,
  "relative_equilibrium_tolerance": 0.25,
  "relative_equilibrium_parity_tolerance": 0.03,
  "transport_odd_tolerance": 0.12,
  "transport_magnitude_tolerance": 0.12,
  "min_transport_signal": 0.006,
  "max_excitation_relative_std": 0.7,
  "max_trajectory_ds_cv": 0.3,
  "max_trajectory_relative_length_change": 0.12,
  "max_rigid_shape_residual": 0.18,
  "max_log_norm_growth": 2.0,
  "max_tangent_fraction": 0.4,
  "max_rigid_fraction": 0.4,
  "spectral_parity_tolerance": 0.025,
  "max_achieved_cfl": 0.25,
  "transport_window": 0.4,
  "transport_locality_power": 2.0,
  "excitation_transport_odd_tolerance": 0.16
}
