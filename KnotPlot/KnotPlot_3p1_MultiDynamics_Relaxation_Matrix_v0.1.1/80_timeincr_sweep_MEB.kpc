% ======================================================================
% 80_timeincr_sweep_MEB.kpc
% KnotPlot 3.1 controlled relaxation matrix
% Purpose: KnotPlot dynamical time-increment sweep; tests numerical/path dependence.
%
% IMPORTANT:
% - Every candidate starts from reset all + load 3.1.
% - refine nbeads 300 is used because the target KnotPlot runtime marks nbeads obsolete.
% - ago is atomic: saves happen only after the requested iterations.
% - All non-swept dynamical parameters are explicitly fixed.
% - Saved .k files use float format; coords .txt are plain XYZ-like data.
% ======================================================================

% ----------------------------------------------------------------------
% Candidate: T80_MEB_dt3p75
% mech=true elec=true bend=true
% charge=15 bencon=1 power=6
% hooke=1 timeincr=3.75
% close=1 max-dr=0.01
% ----------------------------------------------------------------------
reset all
load 3.1
refine nbeads 300
mode cb

centre
fitto mindist 1.05

collision fast
close = 1
max-dr = 0.01

mechforce = on
elecforce = on
bendforce = on

charge 15
hooke 1
power 6
timeincr 3.75
bencon = 1

stusplit = 0
dstep = 1

bradius = 0.1
cradius = 0.05

energy model MD

% Initial state
centre
energy
writhe
length
rog
save KnotPlot_3p1_MultiDynamics_Relaxation_Matrix_v0.1.0/out/T80_MEB_dt3p75_i00000.k float
coords KnotPlot_3p1_MultiDynamics_Relaxation_Matrix_v0.1.0/out/T80_MEB_dt3p75_i00000.txt

% 1,000 iterations
ago 1000
centre
energy
writhe
length
rog
save KnotPlot_3p1_MultiDynamics_Relaxation_Matrix_v0.1.0/out/T80_MEB_dt3p75_i01000.k float
coords KnotPlot_3p1_MultiDynamics_Relaxation_Matrix_v0.1.0/out/T80_MEB_dt3p75_i01000.txt

% 4,000 cumulative iterations
ago 3000
centre
energy
writhe
length
rog
save KnotPlot_3p1_MultiDynamics_Relaxation_Matrix_v0.1.0/out/T80_MEB_dt3p75_i04000.k float
coords KnotPlot_3p1_MultiDynamics_Relaxation_Matrix_v0.1.0/out/T80_MEB_dt3p75_i04000.txt

% 10,000 cumulative iterations
ago 6000
centre
energy
writhe
length
rog
save KnotPlot_3p1_MultiDynamics_Relaxation_Matrix_v0.1.0/out/T80_MEB_dt3p75_i10000.k float
coords KnotPlot_3p1_MultiDynamics_Relaxation_Matrix_v0.1.0/out/T80_MEB_dt3p75_i10000.txt

