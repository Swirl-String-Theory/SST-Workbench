% ============================================================
% SST / KnotPlot user presets
% File: knotplotrc.kps
% ============================================================
resize command 1482 747 7685 1566
resize cpanel 1493 1860 7680 -294
resize view 2560 1369 3840 23

mode cbf;  stusplit = 0; dstep = 1; close = 0.20; max-dr = 0.02
% ------------------------------------------------------------
% Global default behavior
% ------------------------------------------------------------

silent = false

alias sstbase "show backdrop; mode cbf; bradius = 0.2; cradius = 0.1; tanf = on; tanmag = 9; stusplit = 0; dstep = 1; close = 0.20; max-dr = 0.02"

% Apply SST defaults automatically after reset / reset all.
alias .user-reset "sstbase"

% ------------------------------------------------------------
% Standard SST report block
% ------------------------------------------------------------

alias sstreport "safe; dowker; gauss; length; distance; acn"

% Optional shorter topology-only check.
alias ssttopo "safe; dowker; gauss"

% Optional geometry-only check.
alias sstgeom "length; distance; acn"

% ------------------------------------------------------------
% Output XYZ loaders (short aliases)
% Borromean: B=BALANCED S=SOFT Q=TIGHT F=FLAT; b/b2/c = patch variants
% Seeds: N1k=N1024 N2k=N2048; 11_1=11a367 (torus) 11_2=11a247 (twist)
% selection: m=MIRROR cc=ORIG_CPCENTER mcc=MIRROR_CPCENTER; 665=6_6_5
% *go32 = load then go 32
% ------------------------------------------------------------

% --- borromean clean N1024 / N2048 ---
alias 556B1024 "reset all; load Output/borromean/Borromean_5_5_6_BALANCED_N1024.xyz"
alias 556B1024go32 "556B1024; go 32"
alias 556S1024 "reset all; load Output/borromean/Borromean_5_5_6_SOFT_N1024.xyz"
