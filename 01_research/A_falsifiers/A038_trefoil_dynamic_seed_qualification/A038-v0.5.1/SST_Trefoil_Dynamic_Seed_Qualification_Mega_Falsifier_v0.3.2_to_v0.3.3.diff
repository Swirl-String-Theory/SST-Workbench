+def resample_closed_periodic_cubic(x,n,oversample_factor=16,min_oversample=1024):
+    """Uniform-arclength remap of a closed smooth centerline using a periodic cubic spline.
+
+    The input vertices are treated as samples of one periodic C2 centerline.  The
+    spline parameter knots use cumulative chord length; a dense spline quadrature
+    then approximates the spline arclength and is inverted to obtain uniform
+    arclength sample positions.  The first marker is preserved as the phase anchor.
+
+    This is intentionally separate from ``resample_closed``.  The latter is the
+    historical polygonal/linear utility used by legacy stages; S37C+ uses this
+    periodic-cubic map so the physical RK4 operator and the relabeling operator are
+    cleanly separated without repeated polygonal corner cutting.
+    """
+    x=np.asarray(x,float)
+    n=int(n)
+    if x.ndim!=2 or x.shape[1]!=3 or len(x)<4 or n<4:
+        raise ValueError('periodic cubic remap requires Nx3 closed samples with N>=4')
+    d=segment_lengths(x)
+    if not np.isfinite(d).all() or np.any(d<=1e-15):
+        raise ValueError('degenerate segment in periodic cubic remap')
+    s=np.r_[0.0,np.cumsum(d)]
+    L=float(s[-1])
+    xp=np.vstack([x,x[0]])
+    u=s/L
+    cs=CubicSpline(u,xp,axis=0,bc_type='periodic')
+    m=max(int(min_oversample),int(oversample_factor*max(len(x),n)))
+    ud=np.linspace(0.0,1.0,m+1)
+    xd=cs(ud)
+    dd=np.linalg.norm(np.diff(xd,axis=0),axis=1)
+    sd=np.r_[0.0,np.cumsum(dd)]
+    Ls=float(sd[-1])
+    if not np.isfinite(Ls) or Ls<=1e-15:
+        raise ValueError('degenerate spline arclength in periodic cubic remap')
+    q=np.linspace(0.0,Ls,n,endpoint=False)
+    uq=np.interp(q,sd,ud)
+    out=np.asarray(cs(uq),float)
+    out[0]=x[0]  # exact cyclic phase anchor
+    return out
