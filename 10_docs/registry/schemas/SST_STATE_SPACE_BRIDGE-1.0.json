{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SST_STATE_SPACE_BRIDGE-1.0",
  "title": "SST_STATE_SPACE_BRIDGE-1.0",
  "description": "Qualification certificate for one preregistered filament-to-core-field map P_BS. Not a phase PASS.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "record_type",
    "status",
    "prediction_inputs_consumed",
    "scientific_amplitude",
    "d_bridge",
    "d_score",
    "holdout_scoring_enabled",
    "bridge_rejected_falsifies_a029_clock"
  ],
  "properties": {
    "schema": { "const": "SST_STATE_SPACE_BRIDGE-1.0" },
    "schema_version": { "const": "1.0" },
    "record_type": { "const": "state_space_bridge" },
    "status": {
      "enum": [
        "BRIDGE_QUALIFIED",
        "BRIDGE_REJECTED",
        "INDETERMINATE_MODE_RECONSTRUCTION",
        "INDETERMINATE_TUBE_CHART_INVALID",
        "INDETERMINATE_INSUFFICIENT_STATE",
        "INDETERMINATE_NO_VALID_PRODUCER"
      ]
    },
    "prediction_inputs_consumed": {
      "type": "array",
      "maxItems": 0
    },
    "scientific_amplitude": { "const": "left_eigenvector_Wr_B" },
    "d_bridge": { "type": "array", "items": { "type": "string" } },
    "d_score": { "type": "array", "items": { "type": "string" } },
    "holdout_scoring_enabled": { "type": "boolean" },
    "bridge_rejected_falsifies_a029_clock": { "const": false },
    "mode_recon_sha256": { "type": ["string", "null"] },
    "tube_cert_sha256": { "type": ["string", "null"] },
    "thresholds_sha256": { "type": ["string", "null"] }
  }
}
