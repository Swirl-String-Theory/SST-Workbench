# Default: CRLF on Windows checkout/commit
* text=auto eol=crlf

# Explicit text types
*.py   text eol=crlf
*.md   text eol=crlf
*.txt  text eol=crlf
*.json text eol=crlf
*.csv  text eol=crlf
*.tex  text eol=crlf
*.ps1  text eol=crlf
*.sh   text eol=crlf

# Binary — no EOL conversion
*.png  -text
*.jpg  -text
*.gif  -text
*.pdf  -text
*.npz  -text
*.npy  -text
*.tif  -text
