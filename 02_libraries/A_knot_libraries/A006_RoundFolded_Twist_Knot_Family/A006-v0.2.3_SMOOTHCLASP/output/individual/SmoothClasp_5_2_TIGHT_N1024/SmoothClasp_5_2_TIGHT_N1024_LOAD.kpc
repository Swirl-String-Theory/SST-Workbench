reset all
show backdrop
mode cbf
bradius = 0.2
cradius = 0.1
tanf = on
tanmag = 9
stusplit = 0
dstep = 1
close = 0.20
max-dr = 0.02
load output/individual/SmoothClasp_5_2_TIGHT_N1024/SmoothClasp_5_2_TIGHT_N1024.kpt
information
length
parameters close
parameters max-dr
coords output/individual/SmoothClasp_5_2_TIGHT_N1024/SmoothClasp_5_2_TIGHT_N1024_BEFORE.xyz
go 1
coords output/individual/SmoothClasp_5_2_TIGHT_N1024/SmoothClasp_5_2_TIGHT_N1024_AFTER1.xyz
go 32
coords output/individual/SmoothClasp_5_2_TIGHT_N1024/SmoothClasp_5_2_TIGHT_N1024_AFTER33.xyz
