% build_knot_10.123.kpc
reset all
load 10.123
nbeads 300
mode cb

centre
fitto mindist 1.05

collision fast
close = 1.0
max-dr = 0.01

mechforce = on
elecforce = on
bendforce = on
bencon = 1.0

stusplit = 0
dstep = 1

bradius = 0.1
cradius = 0.05

energy model MD
energy

echo CHECKPOINT i00000
safe
dowker
lnknum
length
distance
angle
acn
save KnotPlot_3p1_MultiDynamics_Relaxation_Matrix_v0.1.0/catalog/knot_10.123/knot_10.123_i00000.k float
coords KnotPlot_3p1_MultiDynamics_Relaxation_Matrix_v0.1.0/catalog/knot_10.123/knot_10.123_i00000.txt

ago 1000
