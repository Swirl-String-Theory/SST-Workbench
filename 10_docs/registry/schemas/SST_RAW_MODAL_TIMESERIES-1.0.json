{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SST_RAW_MODAL_TIMESERIES-1.0",
  "title": "SST_RAW_MODAL_TIMESERIES-1.0",
  "description": "Generic raw complex modal coefficient series a_m(t), written before predictor post-processing. Later C006/A031/A021 may emit the same record type.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "record_type",
    "source_id",
    "t",
    "a_real",
    "a_imag",
    "spatial_mode_basis_source",
    "spatial_basis_hash",
    "written_before_predictor_postprocess",
    "predicted_omega_used_in_extraction",
    "predicted_vg_used_in_extraction",
    "predicted_omega_used_for_demodulation",
    "predicted_omega_used_for_bandpass",
    "synthetic_wavepacket_used",
    "scientific"
  ],
  "properties": {
    "schema": { "const": "SST_RAW_MODAL_TIMESERIES-1.0" },
    "schema_version": { "const": "1.0" },
    "record_type": { "const": "raw_modal_timeseries" },
    "source_id": { "type": "string" },
    "provider_id": { "type": ["string", "null"] },
    "carrier_group_token": { "type": ["string", "null"] },
    "t": { "type": "array", "items": { "type": "number" }, "minItems": 2 },
    "a_real": { "type": "array", "items": { "type": "number" } },
    "a_imag": { "type": "array", "items": { "type": "number" } },
    "spatial_mode_basis_source": {
      "enum": ["model_conditioned_frozen", "measurement_fixed", "unavailable"]
    },
    "spatial_basis_hash": { "type": "string", "minLength": 64, "maxLength": 64 },
    "written_before_predictor_postprocess": { "type": "boolean" },
    "predicted_omega_used_in_extraction": { "type": "boolean" },
    "predicted_vg_used_in_extraction": { "type": "boolean" },
    "predicted_omega_used_for_demodulation": { "type": "boolean" },
    "predicted_omega_used_for_bandpass": { "type": "boolean" },
    "synthetic_wavepacket_used": { "type": "boolean" },
    "scientific": { "type": "boolean" },
    "selftest": { "type": "boolean" },
    "code_hash": { "type": ["string", "null"] }
  }
}
