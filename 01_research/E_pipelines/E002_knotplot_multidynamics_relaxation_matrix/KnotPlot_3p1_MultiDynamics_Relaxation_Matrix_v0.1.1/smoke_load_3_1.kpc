% smoke_load_3_1.kpc
% Minimal batch smoke: prove load 3.1 + nbeads + save/coords work under -nog.
reset all
load 3.1
refine nbeads 300
mode cb
centre
length
echo SMOKE_OK
save KnotPlot_3p1_MultiDynamics_Relaxation_Matrix_v0.1.0/out/smoke_load_3_1.k float
coords KnotPlot_3p1_MultiDynamics_Relaxation_Matrix_v0.1.0/out/smoke_load_3_1.txt
