+
+
+def biot_savart_batch_with_jacobian(
+    centerline,
+    probes,
+    coefficient: float,
+    epsilon: float,
+    kernel_model: str = "rosenhead_midpoint",
+):
+    """Return regularized Biot--Savart field and analytic spatial Jacobian.
+
+    The returned Jacobian has shape ``(M,3,3)`` with
+    ``J[i,j] = d beta_i / d x_j`` at each probe.
+    """
+    c = np.asarray(centerline, dtype=float)
+    p = np.asarray(probes, dtype=float)
+    if c.ndim != 2 or c.shape[1] != 3 or len(c) < 3:
+        raise ValueError("centerline must have shape (N,3), N>=3")
+    if p.ndim != 2 or p.shape[1] != 3:
+        raise ValueError("probes must have shape (M,3)")
+    if epsilon <= 0:
+        raise ValueError("epsilon must be positive")
+    if kernel_model != "rosenhead_midpoint":
+        raise ValueError(f"unknown kernel_model: {kernel_model}")
+    a = c
+    b = np.roll(c, -1, axis=0)
+    dl = b - a
+    mid = 0.5 * (a + b)
+    beta = np.empty_like(p)
+    jac = np.empty((len(p), 3, 3), dtype=float)
+    eps2 = epsilon * epsilon
+    eye = np.eye(3)
+    for j, q in enumerate(p):
+        r = q[None, :] - mid
+        q2 = np.sum(r * r, axis=1) + eps2
+        inv3 = np.power(q2, -1.5)
+        inv5 = np.power(q2, -2.5)
+        cross_lr = np.cross(dl, r)
+        beta[j] = coefficient * np.sum(cross_lr * inv3[:, None], axis=0)
+        for col in range(3):
+            d_cross = np.cross(dl, eye[col][None, :])
+            term = d_cross * inv3[:, None] - 3.0 * r[:, col, None] * cross_lr * inv5[:, None]
+            jac[j, :, col] = coefficient * np.sum(term, axis=0)
+    return beta.tolist(), jac.tolist()
