% ============================================================
% reexport_uploaded_trefoil.kps
% Load knots/knot_3.1/knot_3.1_relaxed.txt, run SST gate reports,
% and regenerate an EPS view.
% ============================================================

silent = false

alias sstbase "mode cb; elecforce = OFF; mechforce = on;  stusplit = 0; dstep = 1; close = 0.20; max-dr = 0.02"
alias sstreport "safe; dowker; gauss; length; distance; angle; acn"

reset all
load knots/knot_3.1/knot_3.1_relaxed.txt
sstbase
centre
sstreport
save knots/knot_3.1/knot_3.1_relaxed_reexport.txt
psout knots/knot_3.1/knot_3.1_relaxed_reexport