% build_link_5.2.1.kpc
reset all
load 5.2.1
nbeads 600
mode cb

centre
fitto mindist 1.05

collision fast
close = 1.0
max-dr = 0.01

mechforce = on
elecforce = on
bendforce = on
bencon = 1.0

stusplit = 0
dstep = 1

bradius = 0.1
cradius = 0.05

energy model MD
energy

echo CHECKPOINT i00000
safe
dowker
lnknum
length
distance
angle
acn
save KnotPlot_3p1_MultiDynamics_Relaxation_Matrix_v0.1.0/catalog/link_5.2.1/link_5.2.1_i00000.k float
coords KnotPlot_3p1_MultiDynamics_Relaxation_Matrix_v0.1.0/catalog/link_5.2.1/link_5.2.1_i00000.txt

