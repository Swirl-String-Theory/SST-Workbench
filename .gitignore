# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# Unpacked run trees stay on disk so git status stays small (~25k files).
# Outputs still go to GitHub as sibling {pack}_outputs.zip (git add -f) when
# size < 50 MiB, or as 50 MiB *.zip.partNN for archives in [50 MiB, 500 MiB).
# Any other pack-adjacent .zip under 50 MiB is also force-added. Restore_Archives
# and zips >= 50 MiB stay local (GitHub warns at 50 MB / hard-limits at 100 MB).
*.zip
*.npz
**/outputs/
**/outputs_*/
**/*_outputs/
# Hyphenated pack-adjacent output trees (underscore patterns above miss these)
*-outputs/
*-outputs_BLIND/
*-outputs_REVEALED/
**/campaigns/
**/logs/

# Catalog compat layer (junction targets are tracked; junctions are not)
# Junction names live in .git/info/exclude, never here.

# Reveal keys are never committed unless a family is explicitly unblinded
01_research/*/*/keys/
Katlas_Sources_v0.2.2_Outputs/
KnotPlot/qhp/
KnotPlot/qhp_extended/
KnotPlot/qhp_6p3/
KnotPlot/**/out/

# Workbench ephemeral outputs
outputs/tmp/
runs/tmp/
# RidgeRunner solver output: regenerable rigidity-matrix dumps and snapshots
# (A.dat/A.mat run up to 195MB, above GitHub's 100MB per-file push limit)
KnotPlot/ridgerunner/out/
# RidgeRunner knot-trial dumps (can exceed GitHub 50MB soft limit)
KnotPlot/knots/**/*.rr/snapshots/
*.A.dat
*.A.mat
*.log
*.bak
node_modules/

