% ======================================================================
% 70_maxdr_sweep_MEB.kpc
% KnotPlot 3.1 controlled relaxation matrix
% Purpose: Numerical move-cap sweep to separate equilibrium geometry from integration/path dependence.
%
% IMPORTANT:
% - Every candidate starts from reset all + load 3.1.
% - nbeads 300 is used as an absolute bead count.
% - ago is atomic: saves happen only after the requested iterations.
% - All non-swept dynamical parameters are explicitly fixed.
% - Saved .k files use float format; coords .txt are plain XYZ-like data.
% ======================================================================

% ----------------------------------------------------------------------
% Candidate: R70_MEB_maxdr0p0025
% mech=true elec=true bend=true
% charge=15 bencon=1 power=6
% hooke=1 timeincr=15
% close=1 max-dr=0.0025
% ----------------------------------------------------------------------
reset all
load 3.1
nbeads 300
mode cb

centre
fitto mindist 1.05

collision fast
close = 1
max-dr = 0.0025

mechforce = on
elecforce = on
bendforce = on

charge 15
hooke 1
power 6
timeincr 15
bencon = 1

stusplit = 0
dstep = 1

bradius = 0.1
cradius = 0.05

energy model MD

% Initial state
centre
energy
writhe
length
rog
alex -1
save KnotPlot_3p1_MultiDynamics_Relaxation_Matrix_v0.1.0/R70_MEB_maxdr0p0025_i00000.k float
coords KnotPlot_3p1_MultiDynamics_Relaxation_Matrix_v0.1.0/R70_MEB_maxdr0p0025_i00000.txt

% 1,000 iterations
ago 1000
centre
energy
writhe
length
rog
alex -1
save KnotPlot_3p1_MultiDynamics_Relaxation_Matrix_v0.1.0/R70_MEB_maxdr0p0025_i01000.k float
coords KnotPlot_3p1_MultiDynamics_Relaxation_Matrix_v0.1.0/R70_MEB_maxdr0p0025_i01000.txt

% 4,000 cumulative iterations
ago 3000
centre
energy
writhe
length
rog
alex -1
save KnotPlot_3p1_MultiDynamics_Relaxation_Matrix_v0.1.0/R70_MEB_maxdr0p0025_i04000.k float
coords KnotPlot_3p1_MultiDynamics_Relaxation_Matrix_v0.1.0/R70_MEB_maxdr0p0025_i04000.txt

% 10,000 cumulative iterations
ago 6000
centre
energy
writhe
length
rog
alex -1
save KnotPlot_3p1_MultiDynamics_Relaxation_Matrix_v0.1.0/R70_MEB_maxdr0p0025_i10000.k float
coords KnotPlot_3p1_MultiDynamics_Relaxation_Matrix_v0.1.0/R70_MEB_maxdr0p0025_i10000.txt

