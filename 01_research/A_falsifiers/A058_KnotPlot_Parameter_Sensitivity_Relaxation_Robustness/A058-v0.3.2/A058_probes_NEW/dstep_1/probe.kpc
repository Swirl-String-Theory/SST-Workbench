reset all
collision fast
load A058_seed.kpf
elec = on
mech = on
amech = off
velforce = off
tanf = off
grav = off
therm = off
dstep = 1
echo A058_SAFE_START
safe
echo A058_SAFE_START_END
go 32
echo A058_SAFE_FINAL
safe
echo A058_SAFE_FINAL_END
length
rog
alex -1
data open A058_native_metrics.csv
data format "/N,/l,/g,/D,/I"
data header
data
data close
save A058_final.txt ascii
