+
+struct FieldJacobian {
+    Vec3 beta{};
+    std::array<std::array<double, 3>, 3> jacobian{};
+};
+
+inline Vec3 basis_vec(std::size_t j) {
+    if (j == 0) return {1.0, 0.0, 0.0};
+    if (j == 1) return {0.0, 1.0, 0.0};
+    return {0.0, 0.0, 1.0};
+}
+
+inline std::vector<FieldJacobian> biot_savart_field_jacobian_batch(
+    const std::vector<Vec3>& centerline,
+    const std::vector<Vec3>& probes,
+    double coefficient,
+    double epsilon,
+    const std::string& kernel_model = "rosenhead_midpoint") {
+    if (centerline.size() < 3) throw std::invalid_argument("centerline needs >=3 points");
+    if (!(epsilon > 0.0)) throw std::invalid_argument("epsilon must be positive");
+    if (kernel_model != "rosenhead_midpoint") {
+        throw std::invalid_argument("unknown kernel_model: " + kernel_model);
+    }
+    std::vector<FieldJacobian> out(probes.size());
+    const double eps2 = epsilon * epsilon;
+    for (std::size_t q_index = 0; q_index < probes.size(); ++q_index) {
+        FieldJacobian value{};
+        for (std::size_t i = 0; i < centerline.size(); ++i) {
+            const Vec3& a = centerline[i];
+            const Vec3& b = centerline[(i + 1) % centerline.size()];
+            const Vec3 dl = b - a;
+            const Vec3 mid = 0.5 * (a + b);
+            const Vec3 r = probes[q_index] - mid;
+            const double q2 = r.x*r.x + r.y*r.y + r.z*r.z + eps2;
+            const double sqrt_q2 = std::sqrt(q2);
+            const double inv3 = 1.0 / (q2 * sqrt_q2);
+            const double inv5 = inv3 / q2;
+            const Vec3 clr = cross(dl, r);
+            value.beta = value.beta + (coefficient * inv3) * clr;
+            const double rv[3] = {r.x, r.y, r.z};
+            for (std::size_t j = 0; j < 3; ++j) {
+                const Vec3 first = cross(dl, basis_vec(j));
+                const Vec3 deriv = inv3 * first + (-3.0 * rv[j] * inv5) * clr;
+                value.jacobian[0][j] += coefficient * deriv.x;
+                value.jacobian[1][j] += coefficient * deriv.y;
+                value.jacobian[2][j] += coefficient * deriv.z;
+            }
+        }
+        out[q_index] = value;
+    }
+    return out;
+}
+
 }  // namespace sst_fermat
