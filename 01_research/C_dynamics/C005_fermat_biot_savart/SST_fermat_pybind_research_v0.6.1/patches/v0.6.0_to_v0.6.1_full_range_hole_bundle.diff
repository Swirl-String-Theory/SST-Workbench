+{
+  "schema": "sst.fermat.hole-bundle-sweep.v0.6.1",
+  "status": "RESEARCH_TRACK_SWEEP_COMPLETED",
+  "package_version": "0.6.1",
+  "knot_id": "3_1",
+  "epsilon_over_rc": 0.0019,
+  "centerline_points": 256,
+  "estimated_hole_radius_over_rc": 0.5962712178430972,
+  "return_radius_factor": 3.0,
+  "grid": {
+    "mode": "generated_full_range",
+    "definition": {
+      "radius_min": 0.06125,
+      "radius_max": 8.0,
+      "radius_count": 33,
+      "radius_spacing": "log",
+      "circulation_min": -8.0,
+      "circulation_max": 8.0,
+      "circulation_step": 0.25,
+      "radius_anchors": [
