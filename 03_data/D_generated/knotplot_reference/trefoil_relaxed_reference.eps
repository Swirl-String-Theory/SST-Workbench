% High resolution bounding box:
/bbox_llx 36.000000 def /bbox_lly 126.000000 def /bbox_urx 576.000000 def /bbox_ury 666.000000 def


% Scaled by 14.018207
/beadR 2.523277 def
/cylR 1.401821 def


% Conversion from KnotPlot to PostScript coords:
%    x_ps = 14.018207 * x_kp + (291.695894)
%    y_ps = 14.018207 * y_kp + (391.233627)

/psScale 14.018207 def
/psXoff 291.695894 def
/psYoff 391.233627 def

/toPS {psScale mul psYoff add exch psScale mul psXoff add exch} def

%% Start of balls-n-sticks.ps

%  Rob Scharein
%  June 20, 1994

%  XXX drawing mode for beads and sticks.
%  Not officially supported.

%  Modified April 18, 1995 to (slightly) reduce file size.

% This should be fixed to get rid of anti-aliasing artifacts on some PostScript renderers

0.8 beadR mul /beadr exch def
0.5 cylR mul /cylr exch def

/BCol {            % Default border colour
  0 setgray
} def  
      
/FCol {            % Default fill colour
  1 setgray
} def  
      

/bd {              % Draw a bead at (xloc, yloc)
  0 setlinewidth
  BCol 
  /yloc exch def
  /xloc exch def

  newpath
  xloc yloc moveto
  xloc yloc beadR 0 360 arc
  fill

  newpath
  FCol 
  xloc yloc moveto
  xloc yloc beadr 0 360 arc
  fill

} def

/uc {              % Draw a cylinder fragment extending from (xloc1, yloc1)
  0 setlinecap     % to (xloc2, yloc2).  The fragment is not capped.  This
  /yloc2 exch def  % corresponds to a cylinder fragment that does not end
  /xloc2 exch def  % at a bead that is below it.
  /yloc1 exch def
  /xloc1 exch def

  cylR setlinewidth
  0 setgray
  newpath
  xloc1 yloc1 moveto
  xloc2 yloc2 lineto
  stroke

  cylr setlinewidth
  1 setgray
  newpath
  xloc1 yloc1 moveto
  xloc2 yloc2 lineto
  stroke
} def



/cc {               % Draw a cylinder fragment extending from (xloc1, yloc1)
  1 setlinecap      % to (xloc2, yloc2).  The fragment is capped.  This 
  /yloc2 exch def   % corresponds to a cylinder fragment that has a terminus
  /xloc2 exch def   % ending at a bead that is below it.
  /yloc1 exch def
  /xloc1 exch def

  cylR setlinewidth
  0 setgray
  newpath
  xloc1 yloc1 moveto
  xloc2 yloc2 lineto
  stroke

  cylr setlinewidth
  1 setgray
  newpath
  xloc1 yloc1 moveto
  xloc2 yloc2 lineto
  stroke
} def

%% End of balls-n-sticks.ps


% The following are provided for convenience      if you want to
% customize the appearance of different beads.

/bd0 {bd} def
/cc0 {cc} def
/uc0 {uc} def

 % End bd definitions

% End definitions



gsave

