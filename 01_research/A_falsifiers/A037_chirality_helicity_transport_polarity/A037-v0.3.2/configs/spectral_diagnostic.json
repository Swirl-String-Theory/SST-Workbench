{
  "dataset": "..\\..\\KnotPlot\\knots\\final",
  "max_pairs": 4,
  "target_name_patterns": [
    "(?:knot|trefoil)?[^0-9]*3[._-]1",
    "(?:knot)?[^0-9]*7[._-]4",
    "(?:knot)?[^0-9]*4[._-]1",
    "torus[^0-9]*2[._-]7"
  ],
  "mirror_axis": 0,
  "resolutions": [
    64,
    80
  ],
  "min_points_per_component": 20,
  "core_fractions": [
    0.025
  ],
  "component_gap_factor": 6.0,
  "allow_equal_torus_split": true,
  "reject_ambiguous_links": true,
  "max_ds_cv_prepare": 0.35,
  "max_ds_cv": 0.28,
  "trajectory_time": 0.06,
  "trajectory_cfl": 0.2,
  "min_trajectory_steps": 16,
  "max_trajectory_steps": 80,
  "trajectory_samples": 12,
  "jvp_eps_fraction": 2e-05,
  "fd_eps_fraction": 2e-05,
  "packet_width": 0.08,
  "transport_dead_zone": 0.02,
  "excitation_centers": [
    0.25,
    0.75
  ],
  "carrier_modes": [
    3
  ],
  "excite_all_components": false,
  "max_excited_components": 1,
  "compute_tube_helicity": false,
  "compute_frozen_spectrum": true,
  "max_spectrum_points": 96,
  "helicity_odd_tolerance": 0.08,
  "gauss_odd_tolerance": 0.08,
  "relative_equilibrium_tolerance": 0.35,
  "relative_equilibrium_parity_tolerance": 0.05,
  "transport_odd_tolerance": 0.2,
  "transport_magnitude_tolerance": 0.2,
  "min_transport_signal": 0.008,
  "max_excitation_relative_std": 0.9,
  "max_trajectory_ds_cv": 0.35,
  "max_trajectory_relative_length_change": 0.2,
  "max_rigid_shape_residual": 0.25,
  "max_log_norm_growth": 2.5,
  "max_tangent_fraction": 0.5,
  "max_rigid_fraction": 0.5,
  "spectral_parity_tolerance": 0.04,
  "max_achieved_cfl": 0.32,
  "transport_window": 0.4,
  "transport_locality_power": 2.0,
  "excitation_transport_odd_tolerance": 0.25
}
