reset all
collision fast
load A058_seed.kpf
elec = on
mech = on
amech = off
velforce = off
tanf = off
grav = off
therm = off
dstep = 4
echo A058_READBACK_BEGIN
parameters
echo A058_READBACK_END
echo A058_SAFE_START
safe
echo A058_SAFE_START_END
go 32
echo A058_SAFE_FINAL
safe
echo A058_SAFE_FINAL_END
data open A058_native_metrics.csv
data format "/N,/l,/g,/I"
data header
length
rog
data
data close
save A058_final.txt ascii
