
% ============================================================
% SST / KnotPlot user presets
% File: knotplotrc.kps
% ============================================================
mode cbf;  stusplit = 0; dstep = 1; close = 0.20; max-dr = 0.02
% ------------------------------------------------------------
% Global default behavior
% ------------------------------------------------------------

silent = false

alias sstbase "show backdrop; mode cbf; fitto avlength 0.5;  bradius = 0.2; cradius = 0.1; tanf = on; tanmag = 9; stusplit = 0; dstep = 1; close = 0.20; max-dr = 0.02"

% Apply SST defaults automatically after reset / reset all.
alias .user-reset "sstbase"

% ------------------------------------------------------------
% Standard SST report block
% ------------------------------------------------------------

alias sstreport "safe; dowker; gauss; length; distance; acn"

% Optional shorter topology-only check.
alias ssttopo "safe; dowker; gauss"

% Optional geometry-only check.
alias sstgeom "length; distance; acn"

% ------------------------------------------------------------
% NearUnknot output loaders (short aliases)
% N=NEAR_UNKNOT, R=ROUND, T=TOROIDAL; *go32 = load then ago 32
% ------------------------------------------------------------

alias 52N256 "< output/individual/NearUnknot_5_2_NEAR_UNKNOT_N0256/NearUnknot_5_2_NEAR_UNKNOT_N0256_LOAD.kpc"
alias 52N256go32 "52N256; ago 32"
alias 52N512 "< output/individual/NearUnknot_5_2_NEAR_UNKNOT_N0512/NearUnknot_5_2_NEAR_UNKNOT_N0512_LOAD.kpc"
alias 52N512go32 "52N512; ago 32"
alias 52N1024 "< output/individual/NearUnknot_5_2_NEAR_UNKNOT_N1024/NearUnknot_5_2_NEAR_UNKNOT_N1024_LOAD.kpc"
alias 52N1024go32 "52N1024; ago 32"
alias 52R256 "< output/individual/NearUnknot_5_2_ROUND_N0256/NearUnknot_5_2_ROUND_N0256_LOAD.kpc"
alias 52R256go32 "52R256; ago 32"
alias 52R512 "< output/individual/NearUnknot_5_2_ROUND_N0512/NearUnknot_5_2_ROUND_N0512_LOAD.kpc"
alias 52R512go32 "52R512; ago 32"
alias 52R1024 "< output/individual/NearUnknot_5_2_ROUND_N1024/NearUnknot_5_2_ROUND_N1024_LOAD.kpc"
alias 52R1024go32 "52R1024; ago 32"
alias 52T256 "< output/individual/NearUnknot_5_2_TOROIDAL_N0256/NearUnknot_5_2_TOROIDAL_N0256_LOAD.kpc"
alias 52T256go32 "52T256; ago 32"
alias 52T512 "< output/individual/NearUnknot_5_2_TOROIDAL_N0512/NearUnknot_5_2_TOROIDAL_N0512_LOAD.kpc"
alias 52T512go32 "52T512; ago 32"
alias 52T1024 "< output/individual/NearUnknot_5_2_TOROIDAL_N1024/NearUnknot_5_2_TOROIDAL_N1024_LOAD.kpc"
alias 52T1024go32 "52T1024; ago 32"
alias 61N256 "< output/individual/NearUnknot_6_1_NEAR_UNKNOT_N0256/NearUnknot_6_1_NEAR_UNKNOT_N0256_LOAD.kpc"
alias 61N256go32 "61N256; ago 32"
alias 61N512 "< output/individual/NearUnknot_6_1_NEAR_UNKNOT_N0512/NearUnknot_6_1_NEAR_UNKNOT_N0512_LOAD.kpc"
alias 61N512go32 "61N512; ago 32"
alias 61N1024 "< output/individual/NearUnknot_6_1_NEAR_UNKNOT_N1024/NearUnknot_6_1_NEAR_UNKNOT_N1024_LOAD.kpc"
alias 61N1024go32 "61N1024; ago 32"
alias 61R256 "< output/individual/NearUnknot_6_1_ROUND_N0256/NearUnknot_6_1_ROUND_N0256_LOAD.kpc"
alias 61R256go32 "61R256; ago 32"
alias 61R512 "< output/individual/NearUnknot_6_1_ROUND_N0512/NearUnknot_6_1_ROUND_N0512_LOAD.kpc"
alias 61R512go32 "61R512; ago 32"
alias 61R1024 "< output/individual/NearUnknot_6_1_ROUND_N1024/NearUnknot_6_1_ROUND_N1024_LOAD.kpc"
alias 61R1024go32 "61R1024; ago 32"
alias 61T256 "< output/individual/NearUnknot_6_1_TOROIDAL_N0256/NearUnknot_6_1_TOROIDAL_N0256_LOAD.kpc"
alias 61T256go32 "61T256; ago 32"
alias 61T512 "< output/individual/NearUnknot_6_1_TOROIDAL_N0512/NearUnknot_6_1_TOROIDAL_N0512_LOAD.kpc"
alias 61T512go32 "61T512; ago 32"
alias 61T1024 "< output/individual/NearUnknot_6_1_TOROIDAL_N1024/NearUnknot_6_1_TOROIDAL_N1024_LOAD.kpc"
alias 61T1024go32 "61T1024; ago 32"


% ------------------------------------------------------------
% Trefoil intake preset: core candidate 3_1
% ------------------------------------------------------------

alias ssttrefoil "reset all; load 3.1; mode cbf; split; split; split; split; split; split; split; split; fitto avlength 0.5; show labels; bradius = 0.02; cradius = 0.01; display true; elecforce = off; stusplit = 0; dstep = 1; nbeads = 300 close = 0.20; max-dr = 0.02; sstreport"

alias ssttrefoil300 "reset all; load 3.1; mode cbf; fitto avlength 0.5; refine nbeads 300; elecforce = off; mechforce = on; stusplit = 0; dstep = 1; close = 0.20; max-dr = 0.02; bradius = 0.02; cradius = 0.01; show labels; safe; info; distance; length; angle; acn; dowker; gauss; ago 3000; centre; safe; info; distance; length; angle; acn; dowker; gauss; save Build_Knot_Link_Torus_KnotPlot_Scripts/trefoil_300_relaxed_v2.txt; psout Build_Knot_Link_Torus_KnotPlot_Scripts/trefoil_300_relaxed_v2"

% Run 100 relaxation steps and report topology + geometry.
alias sstgo100 "ago 100; sstreport"
alias sstgo1000 "ago 1000; sstreport"
alias sstgo5000 "ago 5000; sstreport"
alias sstgo10000 "ago 10000; sstreport"


% Safe repeated trefoil run.
alias ssttrefoilrun "ssttrefoil; sstgo1000; save Build_Knot_Link_Torus_KnotPlot_Scripts/trefoil_safe_001.txt; sstgo1000; save Build_Knot_Link_Torus_KnotPlot_Scripts/trefoil_safe_002.txt; sstgo1000; save Build_Knot_Link_Torus_KnotPlot_Scripts/trefoil_safe_003.txt;"

% ------------------------------------------------------------
% Useful SST candidate loaders
% ------------------------------------------------------------

alias k31 "reset all; load 3.1; sstbase; sstreport"
alias k41 "reset all; load 4.1; sstbase; sstreport"
alias k51 "reset all; load 5.1; sstbase; sstreport"
alias k52 "reset all; load 5.2; sstbase; sstreport"
alias k62 "reset all; load 6.2; sstbase; sstreport"
alias k74 "reset all; load 7.4; sstbase; sstreport"

% ------------------------------------------------------------
% Mirror / chirality test
% ------------------------------------------------------------

alias sstmirrorx "reflect x; sstreport"
alias sstmirrory "reflect y; sstreport"
alias sstmirrorz "reflect z; sstreport"

% ------------------------------------------------------------
% Export helpers
% ------------------------------------------------------------

alias sstsave "save sst_current.txt; psout sst_current"


silent = false