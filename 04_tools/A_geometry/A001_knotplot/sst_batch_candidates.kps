% ============================================================
% sst_batch_candidates.kps
% Batch intake for SST candidate knots, links, and torus types.
%
% 47 candidates: 19 knots (load X.Y) + 15 links (load X.Y.Z) + 13 torus (torus p q).
% Exports: knots/knot_*, knots/link_*, knots/torus_* (_relaxed.txt + .eps).
%
% Run from KnotPlot/ working directory:
%   knotplot -nog < sst_batch_candidates.kps
%
% This is geometry intake only; SST physics must be done downstream in SSTcore.
% ============================================================

silent = false

alias sstbase "mode cb; elecforce = OFF; stusplit = 0; dstep = 1; close = 0.20; max-dr = 0.02"
alias sstreport "safe; dowker; gauss; length; distance; angle; acn"
alias sstprep "sstbase; split; split; split; split; split; split; split; split; fitto avlength 0.5; sstreport; ago 9000; centre; sstreport"

% --- multi-component links (load X.Y.Z) ---

reset all
load 0.2.1
sstprep
save knots/link_0.2.1/link_0.2.1_relaxed.txt
psout knots/link_0.2.1/link_0.2.1_relaxed

