        "BYTE_IDENTICAL_MIRROR_NOT_INDEPENDENT",
        "MIRROR_NOT_INDEPENDENT"
      ],
      "max_per_independence_group": 0
    }
  },
  "parent_selection": {
    "max_geometries": 8,
    "policy": "one max-growth representative per anonymous v0.3 independence group, then best-fit, earliest-future-tstar and max-growth anomaly slots; deterministic controls fill overlaps"
  },
  "base": {
    "L": 6.283185307179586,
