+#!/usr/bin/env node
+// Browser runtime smoke for vortexring-lab v7.5.1.
+// Usage: npm i puppeteer && node browser-smoke-v7_5_1.mjs [path-to-html]
+import puppeteer from 'puppeteer';
+import path from 'node:path';
+import process from 'node:process';
+
+const file = path.resolve(process.argv[2] || 'vortexring-lab-v7_5_1.html');
+const url = 'file://' + file + '?selftest=1';
+const errors = [];
+let pass = true;
+const check = (name, ok, detail = '') => {
+  console.log((ok ? 'PASS  ' : 'FAIL  ') + name + (detail ? '  — ' + detail : ''));
+  if (!ok) pass = false;
+};
+
+const browser = await puppeteer.launch({headless: 'new'});
+const page = await browser.newPage();
+page.on('console', m => { if (m.type() === 'error') errors.push(m.text()); });
+page.on('pageerror', e => errors.push(String(e)));
+await page.goto(url, {waitUntil: 'networkidle0', timeout: 60000});
+
+const frames = await page.evaluate(() => new Promise(resolve => {
+  let n = 0;
+  const tick = () => (++n >= 12 ? resolve(n) : requestAnimationFrame(tick));
+  requestAnimationFrame(tick);
+}));
+check('≥10 gerenderde frames', frames >= 10, `${frames} frames`);
+check('geen console-/pageerrors', errors.length === 0, errors.slice(0, 3).join(' | ') || 'schoon');
+
+await page.waitForSelector('#selftestOverlay', {timeout: 30000});
+const st = await page.$eval('#selftestOverlay', el => el.innerText);
+check('zelftest zonder ❌', !st.includes('❌'), st.split('\n')[0]);
+for (const marker of [
+  'T0i', 'T0j', 'T0k', 'T1b', 'T8 frame-equivalentie',
+  'T9f', 'T9g', 'T9h', 'T9i'
+]) check('zelftest bevat ' + marker, st.includes(marker));
+check('zelftestkop meldt v7.5.1 GESLAAGD', st.includes('ZELFTEST 7.5.1') && st.includes('GESLAAGD'));
+
+for (const id of [
+  'rowGa', 'hGa', 'rowEpsRev', 'hEpsRev', 'bEpsRev',
+  'rowHornCore', 'hHornCore', 'sRHorn', 'sRCorePhys', 'bundleSourceNote'
+]) check('UI-element #' + id, await page.$('#' + id) !== null);
+
+// Frame toggle remains display-only.
+const bgBefore = await page.$eval('#cBgOmega', el => el.checked);
+await page.click('#frameSeg [data-frame="absolute"]');
+await page.click('#frameSeg [data-frame="rotating"]');
+const bgAfter = await page.$eval('#cBgOmega', el => el.checked);
+check('frame-toggle laat solverkeuze ongemoeid', bgBefore === bgAfter, `cBgOmega ${bgBefore} → ${bgAfter}`);
+
+// Research-Track fixed-core input is separate from R_horn and a_sim.
+await page.$eval('#sRCorePhys', el => {
+  el.value = '0.001 fm';
+  el.dispatchEvent(new Event('change', {bubbles: true}));
+});
+const coreReadout = await page.$eval('#vRCorePhys', el => el.textContent.trim());
+const hornReadout = await page.$eval('#vRHorn', el => el.textContent.trim());
+check('r_kern-invoer geaccepteerd', coreReadout.includes('am') || coreReadout.includes('fm'), `r_kern=${coreReadout}`);
+check('R_horn blijft canoniek 1.409 fm', hornReadout.includes('1.409') && hornReadout.includes('fm'), `R_horn=${hornReadout}`);
+
+// ε_rev remains a user-triggered finite measurement at α=0.
+await page.click('#bEpsRev');
+await new Promise(r => setTimeout(r, 600));
+const eps = await page.$eval('#hEpsRev', el => el.textContent.trim());
+check('ε_rev geeft eindige meting bij α=0', /e[-+]\d+/i.test(eps), `hEpsRev=${eps}`);
+
+await browser.close();
+console.log(pass ? '\nBROWSER-SMOKE GROEN' : '\nBROWSER-SMOKE ROOD');
+process.exit(pass ? 0 : 1);
